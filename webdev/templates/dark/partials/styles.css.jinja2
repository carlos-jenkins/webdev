:root {
  --bg: #0d1117;
  --bg-elev: #161b22;
  --bg-hover: #1f2630;
  --border: #30363d;
  --text: #e6edf3;
  --text-dim: #9198a1;
  --accent: #4493f8;
  --accent-dim: #388bfd;
  --dir: #d29922;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
  font-size: 14px;
  line-height: 1.5;
}

.wrap {
  max-width: 980px;
  margin: 0 auto;
  padding: 24px 20px 48px;
}

.head { margin-bottom: 16px; }

.crumbs {
  font-size: 18px;
  font-weight: 600;
  word-break: break-all;
}
.crumb { color: var(--accent); text-decoration: none; }
.crumb:hover { text-decoration: underline; }
.crumb.current { color: var(--text); }
.sep { color: var(--text-dim); margin: 0 2px; }

.meta { color: var(--text-dim); margin: 4px 0 0; font-size: 13px; }

.listing {
  width: 100%;
  border-collapse: collapse;
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}

.listing thead th {
  text-align: left;
  font-weight: 600;
  color: var(--text-dim);
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
}
.listing thead th:hover { color: var(--text); }
.listing thead th[aria-sort="ascending"]::after { content: " \2191"; }
.listing thead th[aria-sort="descending"]::after { content: " \2193"; }

.listing td {
  padding: 8px 14px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
.listing tbody tr:last-child td { border-bottom: none; }
.listing tbody tr:hover { background: var(--bg-hover); }

.col-size, .col-date { color: var(--text-dim); white-space: nowrap; }
.col-size { text-align: right; width: 110px; }
.col-date { width: 160px; }

.col-name a { color: var(--text); text-decoration: none; }
.col-name a:hover { color: var(--accent); text-decoration: underline; }
.is-dir .col-name a { color: var(--accent); font-weight: 500; }

.icon {
  display: inline-block;
  width: 1.1em;
  margin-right: 8px;
  text-align: center;
}
.icon::before { color: var(--text-dim); }
.icon-dir::before { content: "\1F4C1"; }
.icon-up::before { content: "\2B06"; }
.icon-file::before { content: "\1F4C4"; }
.icon-image::before { content: "\1F5BC"; }
.icon-video::before { content: "\1F3AC"; }
.icon-audio::before { content: "\1F3B5"; }
.icon-code::before { content: "\1F4C3"; }
.icon-archive::before { content: "\1F4E6"; }
.icon-doc::before { content: "\1F4C4"; }

.empty { color: var(--text-dim); padding: 24px 2px; }

.foot {
  margin-top: 18px;
  color: var(--text-dim);
  font-size: 12px;
}
.foot .dot { margin: 0 6px; }
.foot .ver { font-variant-numeric: tabular-nums; opacity: 0.8; }
